# Fast overlay image: take the official/ACR GPUStack image and lay our changed
# Python files on top of the installed gpustack package. No CUDA/Higress rebuild
# — builds in seconds — for iterating on the LightX2V built-in backend before a
# full `make package`.
#
# Covers M1–M3 (backend enum/registration/scheduling) AND M4/M5 (async video
# facade, sweeper, janitor, migration, usage metering). Keep the COPY list in
# sync when more files change. The Alembic migration file is included and is
# applied automatically on server start (`alembic upgrade head`).
#
# The built gpustack-ui dist is overlaid from pack/ui-dist/ when present (the
# pack-acr-overlay workflow fills it; the committed placeholder keeps local
# builds working without a UI build).
#
# Build (from repo root) and push to ACR:
#   docker build -f pack/Dockerfile.acr \
#     --build-arg BASE_IMAGE=crpi-xzr81d0490mc3794.cn-shanghai.personal.cr.aliyuncs.com/reputationly/gpustack:v2.2.3 \
#     -t crpi-xzr81d0490mc3794.cn-shanghai.personal.cr.aliyuncs.com/reputationly/gpustack:lx2v-dev .
#   docker push crpi-xzr81d0490mc3794.cn-shanghai.personal.cr.aliyuncs.com/reputationly/gpustack:lx2v-dev
#
# NOTE on arch: server=x86, compute worker=arm64. This overlay is arch-agnostic
# (pure .py), but build it for each arch you deploy to (or build multi-arch with
# buildx) so the base layers match the target node.
#
# NOTE on BASE_IMAGE: pin it to the SAME upstream release this repo is merged up
# to (currently v2.2.3), never a floating :latest. The overlay whole-file
# overwrites ~38 modules; if the base is a different release those files silently
# downgrade half the image while the rest stays newer. Sync the base first:
#   SRC=quay.io/gpustack/gpustack:v2.2.3 ./hack/sync-image-to-acr.sh v2.2.3

ARG BASE_IMAGE=crpi-xzr81d0490mc3794.cn-shanghai.personal.cr.aliyuncs.com/reputationly/gpustack:v2.2.3
FROM ${BASE_IMAGE}

# Stage the changed files, preserving their package-relative paths.
# --- M1-M3: backend enum / registration / scheduling ---
COPY gpustack/schemas/models.py                                              /tmp/lx2v-overlay/schemas/models.py
COPY gpustack/schemas/inference_backend.py                                   /tmp/lx2v-overlay/schemas/inference_backend.py
# base.py 与 inference_backend.py 成对:容器 /dev/shm 上限的默认值只在 schema 里定
# 一份,base.py 负责读它。只叠其中一个,另一个仍是基础镜像的旧版本,默认值就分叉了。
COPY gpustack/worker/backends/base.py                                        /tmp/lx2v-overlay/worker/backends/base.py
COPY gpustack/worker/backends/lightx2v.py                                    /tmp/lx2v-overlay/worker/backends/lightx2v.py
COPY gpustack/worker/serve_manager.py                                        /tmp/lx2v-overlay/worker/serve_manager.py
COPY gpustack/worker/model_meta.py                                           /tmp/lx2v-overlay/worker/model_meta.py
COPY gpustack/worker/runtime_metrics_aggregator.py                           /tmp/lx2v-overlay/worker/runtime_metrics_aggregator.py
COPY gpustack/policies/candidate_selectors/lightx2v_resource_fit_selector.py /tmp/lx2v-overlay/policies/candidate_selectors/lightx2v_resource_fit_selector.py
COPY gpustack/scheduler/scheduler.py                                         /tmp/lx2v-overlay/scheduler/scheduler.py
# NOTE: scheduler/evaluator.py is deliberately NOT overlaid. Our fork used to
# patch evaluate_runtime_version() to skip the runner runtime-version matrix for
# the five self-contained built-in backends; upstream 3b2d50c6 (in v2.2.3)
# deleted that check outright, so our file is now byte-identical to the base
# image's. Overlaying it would only risk reverting future upstream fixes.
# --- IndexTTS built-in backend (TTS) ---
COPY gpustack/worker/backends/indextts.py                                    /tmp/lx2v-overlay/worker/backends/indextts.py
COPY gpustack/policies/candidate_selectors/indextts_resource_fit_selector.py /tmp/lx2v-overlay/policies/candidate_selectors/indextts_resource_fit_selector.py
# --- ACE-Step built-in backend (text-to-music) ---
COPY gpustack/worker/backends/acestep.py                                     /tmp/lx2v-overlay/worker/backends/acestep.py
COPY gpustack/policies/candidate_selectors/acestep_resource_fit_selector.py  /tmp/lx2v-overlay/policies/candidate_selectors/acestep_resource_fit_selector.py
# --- vLLM-Omni built-in backend (multi-model speech/TTS; supersedes IndexTTS) ---
COPY gpustack/worker/backends/vllm_omni.py                                    /tmp/lx2v-overlay/worker/backends/vllm_omni.py
COPY gpustack/policies/candidate_selectors/vllm_omni_resource_fit_selector.py /tmp/lx2v-overlay/policies/candidate_selectors/vllm_omni_resource_fit_selector.py
# --- Bernini built-in backend (native video gen/edit; Bernini-R renderer) ---
COPY gpustack/worker/backends/bernini.py                                     /tmp/lx2v-overlay/worker/backends/bernini.py
COPY gpustack/policies/candidate_selectors/bernini_resource_fit_selector.py  /tmp/lx2v-overlay/policies/candidate_selectors/bernini_resource_fit_selector.py
COPY gpustack/assets/model-catalog.yaml                                      /tmp/lx2v-overlay/assets/model-catalog.yaml
# Catalog icon lands under the installed UI static dir (copy_extra_static
# equivalent); staged separately because it's outside the gpustack/ pkg tree.
COPY static/catalog_icons/index-tts.png                                      /tmp/lx2v-static/catalog_icons/index-tts.png
# --- M4/M5: async video facade + sweeper + janitor + migration + metering ---
COPY gpustack/api/middlewares.py                                             /tmp/lx2v-overlay/api/middlewares.py
COPY gpustack/api/exceptions.py                                              /tmp/lx2v-overlay/api/exceptions.py
COPY gpustack/config/config.py                                               /tmp/lx2v-overlay/config/config.py
COPY gpustack/http_proxy/strategies.py                                       /tmp/lx2v-overlay/http_proxy/strategies.py
COPY gpustack/migrations/versions/2026_07_05_2230-e1f2a3b4c5d6_add_video_generation_tasks.py /tmp/lx2v-overlay/migrations/versions/2026_07_05_2230-e1f2a3b4c5d6_add_video_generation_tasks.py
COPY gpustack/migrations/versions/2026_08_11_1030-f3a1b2c4d5e7_add_video_task_progress.py     /tmp/lx2v-overlay/migrations/versions/2026_08_11_1030-f3a1b2c4d5e7_add_video_task_progress.py
COPY gpustack/routes/routes.py                                               /tmp/lx2v-overlay/routes/routes.py
# Runtime config persistence: PUT /v2/config now writes to the runtime_configs
# table and server.py replays it at startup, so UI edits survive an upgrade.
COPY gpustack/routes/config.py                                               /tmp/lx2v-overlay/routes/config.py
COPY gpustack/schemas/runtime_config.py                                      /tmp/lx2v-overlay/schemas/runtime_config.py
COPY gpustack/server/init_db.py                                              /tmp/lx2v-overlay/server/init_db.py
COPY gpustack/migrations/versions/2026_09_02_1200-a7c3e5d19b42_add_runtime_configs.py       /tmp/lx2v-overlay/migrations/versions/2026_09_02_1200-a7c3e5d19b42_add_runtime_configs.py
COPY gpustack/migrations/versions/2026_09_02_1800-b8d4f6a2c1e9_add_video_task_assigned_at.py /tmp/lx2v-overlay/migrations/versions/2026_09_02_1800-b8d4f6a2c1e9_add_video_task_assigned_at.py
COPY gpustack/routes/video_tasks.py                                          /tmp/lx2v-overlay/routes/video_tasks.py
COPY gpustack/routes/videos.py                                               /tmp/lx2v-overlay/routes/videos.py
COPY gpustack/routes/benchmarks.py                                           /tmp/lx2v-overlay/routes/benchmarks.py
COPY gpustack/schemas/__init__.py                                            /tmp/lx2v-overlay/schemas/__init__.py
COPY gpustack/schemas/model_usage.py                                         /tmp/lx2v-overlay/schemas/model_usage.py
COPY gpustack/schemas/model_routes.py                                        /tmp/lx2v-overlay/schemas/model_routes.py
COPY gpustack/schemas/video_generation_task.py                               /tmp/lx2v-overlay/schemas/video_generation_task.py
COPY gpustack/server/server.py                                               /tmp/lx2v-overlay/server/server.py
# InferenceBackendController.  Carries the common_parameters backfill added in
# 2b524710 (LightX2V UI param hints): built-in seeding is create-only, so
# pre-existing backend rows never receive hints added in a later release. This
# file was changed in the repo but MISSING from this list until the v2.2.3
# merge, so the backfill had never actually shipped.
COPY gpustack/server/controllers.py                                          /tmp/lx2v-overlay/server/controllers.py
COPY gpustack/server/video_storage_janitor.py                                /tmp/lx2v-overlay/server/video_storage_janitor.py
COPY gpustack/server/video_task_sweeper.py                                   /tmp/lx2v-overlay/server/video_task_sweeper.py
COPY gpustack/server/video_progress.py                                       /tmp/lx2v-overlay/server/video_progress.py
COPY gpustack/utils/config.py                                                /tmp/lx2v-overlay/utils/config.py
# --- M5: built gpustack-ui dist (placeholder when building locally) ---
COPY pack/ui-dist/ /tmp/lx2v-ui/

# Copy them onto the installed gpustack package (path detected at build time),
# then byte-compile the new modules to fail fast on any import/syntax error.
#
# Migration chain fix-up: our repo's FIRST migration declares down_revision =
# <fork HEAD's previous migration>, but the BASE image ships only the released
# migration chain, which may not contain that revision (upstream-main
# migrations that never made the release must NOT be copied in — their code
# isn't in the image). So detect the base image's actual alembic head BEFORE
# overlaying, then rewrite that migration's down_revision to it, and assert the
# resulting chain resolves to our LAST revision as the single head.
#
# Only the chain ROOT (e1f2a3b4c5d6) is rewritten; our later migrations stay
# chained to it. Adding one means: COPY it in above, and update the head
# assertion below to its revision id.
RUN set -eux; \
    GP_DIR="$(python3 -c 'import gpustack, os; print(os.path.dirname(gpustack.__file__))')"; \
    BASE_HEAD="$(python3 -c "from alembic.config import Config; from alembic.script import ScriptDirectory; c=Config(); c.set_main_option('script_location', '${GP_DIR}/migrations'); print(ScriptDirectory.from_config(c).get_current_head())")"; \
    echo "base image alembic head: ${BASE_HEAD}"; \
    cp -rv /tmp/lx2v-overlay/. "${GP_DIR}/"; \
    rm -rf /tmp/lx2v-overlay; \
    MIG_FILE="${GP_DIR}/migrations/versions/2026_07_05_2230-e1f2a3b4c5d6_add_video_generation_tasks.py"; \
    sed -i "s/^down_revision: Union\[str, None\] = .*/down_revision: Union[str, None] = '${BASE_HEAD}'/" "${MIG_FILE}"; \
    grep -n "^down_revision" "${MIG_FILE}"; \
    python3 -c "from alembic.config import Config; from alembic.script import ScriptDirectory; c=Config(); c.set_main_option('script_location', '${GP_DIR}/migrations'); h=ScriptDirectory.from_config(c).get_current_head(); assert h == 'b8d4f6a2c1e9', h; print('migration chain OK, head=' + h)"; \
    python3 -m py_compile \
        "${GP_DIR}/worker/backends/lightx2v.py" \
        "${GP_DIR}/worker/backends/indextts.py" \
        "${GP_DIR}/worker/backends/acestep.py" \
        "${GP_DIR}/policies/candidate_selectors/lightx2v_resource_fit_selector.py" \
        "${GP_DIR}/policies/candidate_selectors/indextts_resource_fit_selector.py" \
        "${GP_DIR}/policies/candidate_selectors/acestep_resource_fit_selector.py" \
        "${GP_DIR}/worker/backends/vllm_omni.py" \
        "${GP_DIR}/policies/candidate_selectors/vllm_omni_resource_fit_selector.py" \
        "${GP_DIR}/worker/backends/bernini.py" \
        "${GP_DIR}/policies/candidate_selectors/bernini_resource_fit_selector.py" \
        "${GP_DIR}/schemas/inference_backend.py" \
        "${GP_DIR}/worker/backends/base.py" \
        "${GP_DIR}/scheduler/scheduler.py" \
        "${GP_DIR}/scheduler/evaluator.py" \
        "${GP_DIR}/worker/model_meta.py" \
        "${GP_DIR}/routes/videos.py" \
        "${GP_DIR}/routes/video_tasks.py" \
        "${GP_DIR}/schemas/video_generation_task.py" \
        "${GP_DIR}/server/video_task_sweeper.py" \
        "${GP_DIR}/server/video_storage_janitor.py" \
        "${GP_DIR}/server/video_progress.py" \
        "${GP_DIR}/migrations/versions/2026_07_05_2230-e1f2a3b4c5d6_add_video_generation_tasks.py" \
        "${GP_DIR}/migrations/versions/2026_08_11_1030-f3a1b2c4d5e7_add_video_task_progress.py" \
        "${GP_DIR}/migrations/versions/2026_09_02_1200-a7c3e5d19b42_add_runtime_configs.py" \
        "${GP_DIR}/migrations/versions/2026_09_02_1800-b8d4f6a2c1e9_add_video_task_assigned_at.py" \
        "${GP_DIR}/schemas/runtime_config.py" \
        "${GP_DIR}/routes/config.py" \
        "${GP_DIR}/server/init_db.py"; \
    python3 -c "from gpustack.schemas.models import BackendEnum, CategoryEnum; assert BackendEnum.LIGHTX2V and CategoryEnum.VIDEO; print('lx2v backend overlay OK')"; \
    python3 -c "from gpustack.schemas.models import BackendEnum; assert BackendEnum.INDEXTTS; print('indextts backend overlay OK')"; \
    python3 -c "from gpustack.schemas.models import BackendEnum, CategoryEnum; assert BackendEnum.ACESTEP and CategoryEnum.MUSIC; print('acestep backend + music category overlay OK')"; \
    python3 -c "from gpustack.schemas.models import BackendEnum; assert BackendEnum.VLLM_OMNI; from gpustack.worker.backends.vllm_omni import VLLMOmniServer; from gpustack.policies.candidate_selectors.vllm_omni_resource_fit_selector import VLLMOmniResourceFitSelector; print('vllm-omni backend overlay OK')"; \
    python3 -c "from gpustack.schemas.models import BackendEnum, CategoryEnum; assert BackendEnum.BERNINI and CategoryEnum.VIDEO; from gpustack.worker.backends.bernini import BerniniServer; from gpustack.policies.candidate_selectors.bernini_resource_fit_selector import BerniniResourceFitSelector; print('bernini backend overlay OK')"; \
    grep -q "IndexTTS-2" "${GP_DIR}/assets/model-catalog.yaml" && echo "catalog overlay OK"; \
    mkdir -p "${GP_DIR}/ui/static/catalog_icons"; \
    cp -v /tmp/lx2v-static/catalog_icons/index-tts.png "${GP_DIR}/ui/static/catalog_icons/"; \
    rm -rf /tmp/lx2v-static; \
    python3 -c "from gpustack.schemas.video_generation_task import VideoGenerationTask; from gpustack.schemas.model_usage import OperationEnum; assert OperationEnum.VIDEO_GENERATION; print('M4 schema overlay OK')"; \
    if [ -f /tmp/lx2v-ui/index.html ]; then \
        cp -a /tmp/lx2v-ui/. "${GP_DIR}/ui/"; \
        echo "gpustack-ui dist overlaid"; \
    else \
        echo "no UI dist staged; keeping base image UI"; \
    fi; \
    rm -rf /tmp/lx2v-ui
